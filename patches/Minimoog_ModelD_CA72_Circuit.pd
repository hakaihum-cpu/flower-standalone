#N canvas 60 60 970 690 10;
#X text 20 15 MINIMOOG MODEL D - CA72 CIRCUIT-DERIVED DSP (GPL-3.0);
#X text 20 35 Requires native moog_model_d~ object registered by EFFECTS - vanilla Pd alone is insufficient;
#X obj 35 85 notein;
#X obj 35 130 pack f f;
#X obj 35 165 list prepend note;
#X obj 35 195 list trim;
#X obj 35 350 moog_model_d~ 8;
#X obj 35 400 dac~ 1 2;
#X obj 330 90 r effects-x;
#X obj 470 90 list prepend 0;
#X obj 610 90 list prepend param;
#X obj 770 90 list trim;
#X obj 330 155 r effects-y;
#X obj 470 155 list prepend 1;
#X obj 610 155 list prepend param;
#X obj 770 155 list trim;
#X obj 330 220 r knob3;
#X obj 470 220 list prepend 2;
#X obj 610 220 list prepend param;
#X obj 770 220 list trim;
#X obj 330 285 r knob4;
#X obj 470 285 list prepend 3;
#X obj 610 285 list prepend param;
#X obj 770 285 list trim;
#X text 40 455 XY controls: X=cutoff Y=emphasis; CC23=contour amount CC24=filter attack;
#X text 40 475 8 complete CA-72 circuit-derived voices with three VCOs each; output is mono duplicated L/R;
#X text 40 495 Model DSP is native; Pd patch supplies MIDI and host I/O only.;
