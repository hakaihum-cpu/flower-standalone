{
  "id": "eureka576",
  "version": "1.2",
  "title": "MOOD OUTLINE RANDOM 343",
  "category": "Display",
  "author": "analoglav",
  "license": "GPL-2.0-or-later",
  "description": "343 original user MOOD MkII frames converted into black/yellow contour art; BPM/16-bank jump/speed/stutter on note triggers; MIDI+YES toggle. Stock audio unchanged.",
  "device": "digitone-mk1",
  "os": "1.44",
  "sources": [
    "eureka576.c",
    "frames.s"
  ],
  "subscribe": [
    {
      "event": "ev_tick",
      "fn": "eureka576_tick",
      "order": 70
    },
    {
      "event": "ev_draw",
      "fn": "eureka576_draw",
      "order": 70
    },
    {
      "event": "ev_key",
      "fn": "eureka576_key",
      "order": 70
    },
    {
      "event": "ev_note_queue",
      "fn": "eureka576_note_queue",
      "order": 70
    }
  ],
  "requires": [
    "core"
  ],
  "resources": {
    "core": "4.1"
  }
}
