{
  "id": "eureka576",
  "version": "1.6",
  "title": "EUREKA RG DOT 576",
  "category": "Display",
  "author": "analoglav",
  "license": "GPL-2.0-or-later",
  "description": "All 576 original EUREKA user-video frames reprocessed as 128x64 source-preserving Bayer 4x4 black/yellow RG DOT images; each FM voice note triggers JUMP/REVERSE/SPEED/STUTTER and BPM sync; MIDI+YES toggles, stock audio untouched.",
  "device": "digitone-mk1",
  "os": "1.44",
  "sources": [
    "eureka576.c",
    "frames.s"
  ],
  "subscribe": [
    {
      "event": "ev_tick",
      "fn": "eureka576_tick",
      "order": 70
    },
    {
      "event": "ev_draw",
      "fn": "eureka576_draw",
      "order": 70
    },
    {
      "event": "ev_key",
      "fn": "eureka576_key",
      "order": 70
    },
    {
      "event": "ev_voice_on",
      "fn": "eureka576_voice_on",
      "order": 70
    }
  ],
  "requires": [
    "core"
  ],
  "resources": {
    "core": "4.1"
  }
}
