{
  "id": "eureka576",
  "version": "1.1",
  "title": "EUREKA RANDOM 576",
  "category": "Display",
  "author": "analoglav",
  "license": "GPL-2.0-or-later",
  "description": "All 576 original user frames; video jumps, BPM speed and stutter on 30% of synth-track note trigs; MIDI+YES toggles; audio untouched.",
  "device": "digitone-mk1",
  "os": "1.44",
  "sources": [
    "eureka576.c",
    "frames.s"
  ],
  "subscribe": [
    {
      "event": "ev_tick",
      "fn": "eureka576_tick",
      "order": 70
    },
    {
      "event": "ev_draw",
      "fn": "eureka576_draw",
      "order": 70
    },
    {
      "event": "ev_key",
      "fn": "eureka576_key",
      "order": 70
    },
    {
      "event": "ev_note_queue",
      "fn": "eureka576_note_queue",
      "order": 70
    }
  ],
  "requires": [
    "core"
  ],
  "resources": {
    "core": "4.1"
  }
}
