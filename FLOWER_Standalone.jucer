<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="FlowerSA1" name="FLOWER" projectType="audioplug"
              pluginFormats="buildStandalone" companyName="LocalBuild"
              companyWebsite="" companyEmail="" version="0.1.0"
              bundleIdentifier="local.flower.standalone"
              pluginName="FLOWER" pluginDesc="Flower standalone instrument"
              pluginManufacturer="LocalBuild" pluginManufacturerCode="Flwr"
              pluginCode="FLW1" pluginChannelConfigs="{0,2}"
              pluginIsSynth="1" pluginWantsMidiIn="1" pluginProducesMidiOut="0"
              pluginIsMidiEffectPlugin="0"
              pluginCharacteristicsValue="pluginIsSynth,pluginWantsMidiIn"
              displaySplashScreen="0" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1">
  <MAINGROUP id="FlowerRoot" name="FLOWER">
    <GROUP id="{2A5BDAC1-080F-4B6A-9A8E-000000000001}" name="Source">
      <FILE id="pids01" name="ParameterIDs.h" compile="0" resource="0" file="Source/ParameterIDs.h"/>
      <FILE id="modu01" name="Modulation.h" compile="0" resource="0" file="Source/Modulation.h"/>
      <FILE id="svh001" name="SynthVoice.h" compile="0" resource="0" file="Source/SynthVoice.h"/>
      <FILE id="svc001" name="SynthVoice.cpp" compile="1" resource="0" file="Source/SynthVoice.cpp"/>
      <FILE id="retroh" name="RetroLookAndFeel.h" compile="0" resource="0" file="Source/RetroLookAndFeel.h"/>
      <FILE id="retroc" name="RetroLookAndFeel.cpp" compile="1" resource="0" file="Source/RetroLookAndFeel.cpp"/>
      <FILE id="proch1" name="PluginProcessor.h" compile="0" resource="0" file="Source/PluginProcessor.h"/>
      <FILE id="procc1" name="PluginProcessor.cpp" compile="1" resource="0" file="Source/PluginProcessor.cpp"/>
      <FILE id="edhdr1" name="PluginEditor.h" compile="0" resource="0" file="Source/PluginEditor.h"/>
      <FILE id="edcpp1" name="PluginEditor.cpp" compile="1" resource="0" file="Source/PluginEditor.cpp"/>
    </GROUP>
    <GROUP id="{2A5BDAC1-080F-4B6A-9A8E-000000000002}" name="Resources">
      <FILE id="xyvis01" name="flower_xy_square_atlas_exact.jpg" compile="0" resource="1" file="Resources/flower_xy_square_atlas_exact.jpg"/>
    </GROUP>
  </MAINGROUP>

  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android"
                   androidMinimumSDK="24"
                   androidEnableVirtualMidi="0"
                   androidBluetoothScanNeeded="1"
                   androidBluetoothConnectNeeded="1">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug" isDebug="1" optimisation="1"
                       linkTimeOptimisation="0" targetName="FLOWER"
                       androidArchitectures="arm64-v8a"/>
        <CONFIGURATION name="Release" isDebug="0" optimisation="3"
                       linkTimeOptimisation="1" targetName="FLOWER"
                       androidArchitectures="arm64-v8a"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors_headless" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils" path="JUCE/modules"/>
        <MODULEPATH id="juce_core" path="JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="JUCE/modules"/>
        <MODULEPATH id="juce_dsp" path="JUCE/modules"/>
        <MODULEPATH id="juce_events" path="JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="JUCE/modules"/>
      </MODULEPATHS>
    </ANDROIDSTUDIO>
  </EXPORTFORMATS>

  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_plugin_client" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors_headless" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_dsp" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>

  <JUCEOPTIONS JUCE_WEB_BROWSER="disabled" JUCE_USE_CURL="disabled"
               JUCE_VST3_CAN_REPLACE_VST2="disabled"/>
  <LIVE_SETTINGS/>
</JUCERPROJECT>
